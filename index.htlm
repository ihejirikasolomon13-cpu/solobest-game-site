<div id="ui"><div>💀 <span id="kills">0</span></div><div>🏆 <span id="best">BEST: 0</span></div><div>❤️ <span id="hp">3</span></div></div>
<div id="player">🚀</div>
<div id="controls">
<div class="cbtn" ontouchstart="move(-1)" onmousedown="move(-1)">⬅️</div>
