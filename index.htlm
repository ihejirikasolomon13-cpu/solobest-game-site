
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SOLOBEST SHOOTER</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;touch-action:none;user-select:none;}
body{background:#000;display:flex;justify-content:center;overflow:hidden;font-family:Arial Black;}
#game{position:relative;width:100vw;max-width:420px;height:100vh;height:100dvh;background:linear-gradient(#0a0a2a 0%, #1a0033 50%, #000 100%);overflow:hidden;}
#player{position:absolute;width:50px;height:50px;bottom:100px;left:50%;transform:translateX(-50%);font-size:40px;z-index:20;display:flex;align-items:center;justify-content:center;transition:left 0.08s;}
.bullet{position:absolute;width:6px;height:18px;background:linear-gradient(#00ff88,#ffff00);border-radius:3px;box-shadow:0 0 8px #00ff88;z-index:15;}
.enemy{position:absolute;width:45px;height:45px;font-size:35px;z-index:10;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 0 5px red);}
.explosion{position:absolute;font-size:30px;z-index:25;animation:boom 0.4s forwards;}
@keyframes boom{0%{transform:scale(0.5)}50%{transform:scale(1.5)}100%{transform:scale(0);opacity:0}}
#ui{position:absolute;top:0;left:0;right:0;padding:12px 15px;display:flex;justify-content:space-between;color:#fff;z-index:30;font-size:16px;text-shadow:1px 1px 0 #000;}
#ui span{background:rgba(0,255,136,0.2);padding:6px 12px;border-radius:20px;border:1px solid #00ff88;}
#controls{position:absolute;bottom:10px;left:0;right:0;display:flex;justify-content:space-between;padding:0 15px;z-index:30;}
.cbtn{width:70px;height:70px;background:rgba(0,255,136,0.8);border:3px solid #000;border-radius:50%;font-size:30px;display:flex;align-items:center;justify-content:center;}
#fireBtn{width:90px;height:90px;background:radial-gradient(#ff4444,#aa0000);border:4px solid #000;font-size:40px;box-shadow:0 0 20px red;}
#start{position:absolute;inset:0;background:radial-gradient(rgba(20,0,0,0.9),rgba(0,0,0,0.95));z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#00ff88;text-align:center;padding:20px;}
.bigBtn{padding:16px 40px;font-size:20px;background:linear-gradient(#00ff88,#00ffaa);color:#000;border:3px solid #000;border-radius:30px;font-family:Arial Black;box-shadow:0 5px 0 #000;margin-top:15px;}
.smallBtn{background:#fff;padding:8px 18px;font-size:13px;margin-top:10px;border-radius:20px;border:2px solid #000;font-weight:bold;}
</style>
</head>
<body>
<div id="game">
<div id="ui"><div>💀 <span id="kills">0</span></div><div>🏆 <span id="best">BEST: 0</span></div><div>❤️ <span id="hp">3</span></div></div>
<div id="player">🚀</div>
<div id="controls">
<div class="cbtn" ontouchstart="move(-1)" onmousedown="move(-1)">⬅️</div>
<div class="cbtn" id="fireBtn" ontouchstart="shoot()" onmousedown="shoot()">🔥</div>
<div class="cbtn" ontouchstart="move(1)" onmousedown="move(1)">➡️</div>
</div>
<div id="start">
<h1>🔫 SOLOBEST<br>SHOOTER</h1>
<p style="color:#fff;margin-top:10px;">CYBER WARFARE</p>
<p style="color:#aaa;font-family:Arial;font-size:13px;margin-top:15px;">⬅️➡️ Move | 🔥 TAP to SHOOT<br>Destroy aliens, survive!</p>
<p style="color:#888;font-size:12px;margin-top:8px;">Best Kills: <span id="best2">0</span></p>
<button class="bigBtn" onclick="startGame()">START BATTLE ▶️</button>
<button class="smallBtn" onclick="location.href='index.html'">⬅️ GAMES MENU</button>
</div>
</div>
<script>
let playerX=50, kills=0, hp=3, best=localStorage.getItem('shooter_best')||0, running=false, bullets=[], enemies=[], loop, spawnLoop;
let player=document.getElementById('player');
document.getElementById('best').textContent=best; document.getElementById('best2').textContent=best;
function move(dir){ if(!running) return; playerX=Math.max(5,Math.min(95,playerX+dir*6)); player.style.left=playerX+'%'; }
function shoot(){
 if(!running) return;
 let b=document.createElement('div'); b.className='bullet';
 b.style.left=(playerX+0.5)+'%'; b.style.bottom='140px';
 document.getElementById('game').appendChild(b);
 bullets.push({el:b,x:playerX,y:15});
 navigator.vibrate&&navigator.vibrate(20);
 if(window.AudioContext){ try{ let ctx=new (window.AudioContext||window.webkitAudioContext)(); let o=ctx.createOscillator(); o.frequency.value=800; o.connect(ctx.destination); o.start(); setTimeout(()=>o.stop(),80); }catch(e){} }
}
function spawnEnemy(){
 if(!running) return;
 let el=document.createElement('div'); el.className='enemy';
 let types=['👾','👹','🛸','🤖']; el.textContent=types[Math.floor(Math.random()*types.length)];
 el.style.left=Math.random()*80+5+'%'; el.style.top='-10%';
 document.getElementById('game').appendChild(el);
 enemies.push({el,x:parseFloat(el.style.left),y:-10,speed:0.8+Math.random()*1.5+ kills*0.02});
}
function startGame(){
 document.getElementById('start').style.display='none'; running=true; kills=0; hp=3; playerX=50; bullets.forEach(b=>b.el.remove()); enemies.forEach(e=>e.el.remove()); bullets=[]; enemies=[];
 document.getElementById('kills').textContent=0; document.getElementById('hp').textContent=3; player.style.left='50%';
 loop=setInterval(update,16); spawnLoop=setInterval(spawnEnemy,700);
}
function update(){
 if(!running) return;
 bullets.forEach((b,i)=>{
  b.y+=3; b.el.style.bottom=b.y*5+40+'px';
  if(b.y>100){ b.el.remove(); bullets.splice(i,1); return; }
  enemies.forEach((e,j)=>{
   if(Math.abs(b.x-e.x)<6 && Math.abs(b.y - (100-e.y))<8){
    let exp=document.createElement('div'); exp.className='explosion'; exp.textContent='💥'; exp.style.left=e.x+'%'; exp.style.top=e.y+'%'; document.getElementById('game').appendChild(exp);
    setTimeout(()=>exp.remove(),400);
    b.el.remove(); e.el.remove(); bullets.splice(i,1); enemies.splice(j,1);
    kills++; document.getElementById('kills').textContent=kills; navigator.vibrate&&navigator.vibrate(30);
   }
  });
 });
 enemies.forEach((e,i)=>{
  e.y+=e.speed; e.el.style.top=e.y+'%';
  if(e.y>85){
   e.el.remove(); enemies.splice(i,1); hp--; document.getElementById('hp').textContent=hp;
   navigator.vibrate&&navigator.vibrate([80,40,80]);
   if(hp<=0) gameOver();
  }
  if(Math.abs(e.x-playerX)<8 && e.y>75){ e.el.remove(); enemies.splice(i,1); hp--; document.getElementById('hp').textContent=hp; if(hp<=0) gameOver(); }
 });
}
function gameOver(){
 running=false; clearInterval(loop); clearInterval(spawnLoop);
 if(kills>best){ best=kills; localStorage.setItem('shooter_best',best); }
 document.getElementById('best').textContent=best;
 let s=document.getElementById('start'); s.style.display='flex';
 s.innerHTML=`<h1 style="color:#ff4444">💀 DESTROYED</h1><p style="color:#fff;font-size:18px;margin-top:15px;">Kills: ${kills}<br>Best: ${best}</p><button class="bigBtn" onclick="startGame()">RETRY ▶️</button><button class="smallBtn" onclick="location.href='index.html'">⬅️ MENU</button>`;
}
let sx=0;
document.getElementById('game').addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});
document.getElementById('game').addEventListener('touchmove',e=>{
 if(!running) return; let dx=(e.touches[0].clientX-sx)/4; if(Math.abs(dx)>1){ move(dx>0?1:-1); sx=e.touches[0].clientX; }
},{passive:true});
document.addEventListener('keydown',e=>{ if(e.key=='ArrowLeft')move(-1); if(e.key=='ArrowRight')move(1); if(e.key==' ')shoot(); });
</script>
</body>
</html>
---
YES! SHOOTING GAME TIME! 🔫🔥

Let's build *SOLOBEST SHOOTER - Cyber Warfare!*

Features:
- 👾 Enemies coming down
- 🔫 Tap to shoot
- 💥 Explosions
- 🏆 High score
- Works perfect on phone!

---

*STEP 1: Create new file `shoot.html`*

In GitHub, *Add file > New file* > Name: `shoot.html` > Paste this CODE:
