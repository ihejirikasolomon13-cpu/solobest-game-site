 document.getElementById('start').style.display='none'; running=true; kills=0; hp=3; playerX=50; bullets.forEach(b=>b.el.remove()); enemies.forEach(e=>e.el.remove()); bullets=[]; enemies=[];
 document.getElementById('kills').textContent=0; document.getElementById('hp').textContent=3; player.style.left='50%';
 loop=setInterval(update,16); spawnLoop=setInterval(spawnEnemy,700);
}
function update(){
 if(!running) return;
 bullets.forEach((b,i)=>{
  b.y+=3; b.el.style.bottom=b.y*5+40+'px';
  if(b.y>100){ b.el.remove(); bullets.splice(i,1); return; }
  enemies.forEach((e,j)=>{
   if(Math.abs(b.x-e.x)<6 && Math.abs(b.y - (100-e.y))<8){
    let exp=document.createElement('div'); exp.className='explosion'; exp.textContent='💥'; exp.style.left=e.x+'%'; exp.style.top=e.y+'%'; document.getElementById('game').appendChild(exp);
    setTimeout(()=>exp.remove(),400);
    b.el.remove(); e.el.remove(); bullets.splice(i,1); enemies.splice(j,1);
    kills++; document.getElementById('kills').textContent=kills; navigator.vibrate&&navigator.vibrate(30);
   }
  });
 });
 enemies.forEach((e,i)=>{
  e.y+=e.speed; e.el.style.top=e.y+'%';
  if(e.y>85){
   e.el.remove(); enemies.splice(i,1); hp--; document.getElementById('hp').textContent=hp;
   navigator.vibrate&&navigator.vibrate([80,40,80]);
   if(hp<=0) gameOver();
  }
  if(Math.abs(e.x-playerX)<8 && e.y>75){ e.el.remove(); enemies.splice(i,1); hp--; document.getElementById('hp').textContent=hp; if(hp<=0) gameOver(); }
 });
}
function gameOver(){
 running=false; clearInterval(loop); clearInterval(spawnLoop);
 if(kills>best){ best=kills; localStorage.setItem('shooter_best',best); }
 document.getElementById('best').textContent=best;
 let s=document.getElementById('start'); s.style.display='flex';
 s.innerHTML=`<h1 style="color:#ff4444">💀 DESTROYED</h1><p style="color:#fff;font-size:18px;margin-top:15px;">Kills: ${kills}<br>Best: ${best}</p><button class="bigBtn" onclick="startGame()">RETRY ▶️</button><button class="smallBtn" onclick="location.href='index.html'">⬅️ MENU</button>`;
}
let sx=0;
document.getElementById('game').addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});
document.getElementById('game').addEventListener('touchmove',e=>{
 if(!running) return; let dx=(e.touches[0].clientX-sx)/4; if(Math.abs(dx)>1){ move(dx>0?1:-1); sx=e.touches[0].clientX; }
},{passive:true});
document.addEventListener('keydown',e=>{ if(e.key=='ArrowLeft')move(-1); if(e.key=='ArrowRight')move(1); if(e.key==' ')shoot(); });
</script>
</body>
</html>
